# Copy this file to .env.local and fill in the values from Supabase Project Settings > API.
# The publishable key is intended for browser use; database access is still protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public WhatsApp click-to-chat number. Use country code and digits only.
NEXT_PUBLIC_WHOLESALE_WHATSAPP_NUMBER=91XXXXXXXXXX